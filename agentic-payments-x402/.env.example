# ---------------------------------------------------------------------------
# Wallet do agente
# ---------------------------------------------------------------------------
# Chave privada usada para assinar as autorizacoes de pagamento x402 (EIP-3009).
# O valor abaixo e a conta #0 do Anvil/Hardhat: chave publica e conhecida,
# use SOMENTE em ambiente local. Nunca coloque uma chave real aqui.
AGENT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Budget de inteligencia premium disponivel para a viagem (em USD).
PREMIUM_BUDGET_USD=0.20

# ---------------------------------------------------------------------------
# Protocolo x402
# ---------------------------------------------------------------------------
# Rede no formato CAIP-2 (x402 v2). eip155:84532 = Base Sepolia.
X402_NETWORK=eip155:84532

# local    -> facilitator deste repo: verifica a assinatura EIP-712 de verdade
#             e liquida em um ledger em memoria (nao precisa de RPC nem de fundos)
# testnet  -> facilitator publico da x402.org, liquidacao real na Base Sepolia
#             (exige USDC de testnet na carteira do agente)
FACILITATOR_MODE=local
FACILITATOR_URL=http://localhost:4020
FACILITATOR_PORT=4020

# Usado quando FACILITATOR_MODE=testnet. O facilitator publico da x402.org
# submete a transferWithAuthorization on-chain e paga o gas.
TESTNET_FACILITATOR_URL=https://x402.org/facilitator
# RPC de leitura (saldo on-chain) e explorer para os links das liquidacoes.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
EXPLORER_BASE_URL=https://sepolia.basescan.org

# Opcional: faucet para conseguir USDC de testnet. Quando definido, a interface
# mostra um link ao lado do saldo da carteira. Deixe vazio para esconder.
FAUCET_URL=https://faucet.circle.com

# Saldo inicial (USDC) creditado a carteira do agente no ledger do facilitator local.
FACILITATOR_INITIAL_BALANCE_USD=10

# ---------------------------------------------------------------------------
# Marketplace de APIs
# ---------------------------------------------------------------------------
SELLERS_PORT=4021
SELLERS_BASE_URL=http://localhost:4021

# Opcional: redireciona TODOS os providers para um unico endereco. No modo
# testnet, util para ver o USDC chegar na sua propria carteira - ao custo de
# perder a separacao por provider no extrato.
# SELLER_PAY_TO=0x...

# ---------------------------------------------------------------------------
# Modelo do agente (AWS Strands Agents)
# ---------------------------------------------------------------------------
# ollama | bedrock | openai
MODEL_PROVIDER=bedrock

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3:1.7b

BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1
# Perfil AWS a usar (opcional). Com SSO, rode antes: aws sso login --profile <perfil>
# AWS_PROFILE=

OPENAI_MODEL=gpt-5.4
# OPENAI_API_KEY=sk-...

# Prioridades do viajante, em ordem de importancia (entram no pedido junto do objetivo).
TRAVELER_PRIORITIES=evitar conexoes arriscadas,minimizar preco,evitar grande chance de atraso
